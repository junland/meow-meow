version=1.23.0

cd -- "$TMPDIR"

rm -rf groff-$version

unpack "${worktree}/sources/groff-$version.tar.gz"

cd groff-$version

PAGE=A4 ./configure --prefix=/usr

make -j${jobs}

make check -j${jobs}

make install -j${jobs}

if [ "$CLEANUP" == true ]; then
    cd -- "$TMPDIR" && rm -rf groff-$version
fi