version=1.5.7

cd -- "$TMPDIR"

rm -rf libpipeline-$version

unpack "${worktree}/sources/libpipeline-$version.tar.gz"

cd libpipeline-$version

./configure --prefix=/usr

make -j${jobs}

make check -j${jobs}

make install -j${jobs}

if [ "$CLEANUP" == true ]; then
    cd -- "$TMPDIR" && rm -rf libpipeline-$version
fi