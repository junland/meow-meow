# SPDX-FileCopyrightText: 2025, John Unland

version=4.0.4

cd -- "$TMPDIR"

rm -rf procps-v$version

unpack "${worktree}/sources/procps-v$version.tar.gz"

cd procps-v$version

./configure \
    --prefix=/usr \
    --docdir=/usr/share/doc/procps-ng-$version \
    --disable-static \
    --disable-kill

make -j${jobs}

chown -R tester .

su tester -c "PATH=$PATH make check"

make install -j${jobs}

if [ "$CLEANUP" == true ]; then
    cd -- "$TMPDIR" && rm -rf procps-$version
fi
