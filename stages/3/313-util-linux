# SPDX-FileCopyrightText: 2025, John Unland

version=2.40.2

cd -- "$TMPDIR"

rm -rf util-linux-$version

unpack "${worktree}/sources/util-linux-$version.tar.xz"

cd util-linux-$version

./configure \
    ADJTIME_PATH=/var/lib/hwclock/adjtime \
    --bindir=/usr/bin \
    --libdir=/usr/lib \
    --runstatedir=/run \
    --sbindir=/usr/sbin \
    --disable-chfn-chsh \
    --disable-login \
    --disable-nologin \
    --disable-su \
    --disable-setpriv \
    --disable-runuser \
    --disable-pylibmount \
    --disable-static \
    --without-python \
    --without-systemd \
    --without-systemdsystemunitdir \
    --disable-liblastlog2 \
    --docdir=/usr/share/doc/util-linux-${version}

make -j${jobs}

touch /etc/fstab

chown -R tester .

su tester -c "make -k check"

make -j${jobs} install

if [ "$CLEANUP" == true ]; then
    cd -- "$TMPDIR" && rm -rf util-linux-$version
fi
