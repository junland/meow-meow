version=2.7.6

cd -- "$TMPDIR"

rm -rf patch-$version
unpack "${worktree}/sources/patch-$version.tar.xz"

cd patch-$version

./configure --prefix=/usr

make -j${jobs}

make check -j${jobs}

make install -j${jobs}

if [ "$CLEANUP" == true ]; then
    cd -- "$TMPDIR" && rm -rf patch-$version
fi
