# SPDX-FileCopyrightText: 2025, John Unland

version=3.11

cd -- "$TMPDIR"

rm -rf grep-$version
unpack "${worktree}/sources/grep-$version.tar.xz"

cd grep-$version

sed -i "s/echo/#echo/" src/egrep.sh

./configure --prefix=/usr

make -j${jobs}

# Set jobs to half of the number of processors
test_jobs=$(($(jobs) / 2))

make check -j${test_jobs}

make install -j${jobs}

if [ "$CLEANUP" == true ]; then
    cd -- "$TMPDIR" && rm -rf grep-$version
fi