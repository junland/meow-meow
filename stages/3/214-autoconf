# SPDX-FileCopyrightText: 2025, John Unland

version=2.72

cd -- "$TMPDIR"

rm -rf autoconf-$version

unpack "${worktree}/sources/autoconf-$version.tar.xz"

cd autoconf-$version

./configure --prefix=/usr

make -j${jobs}

make check -j${jobs}

make install -j${jobs}

if [ "$CLEANUP" == true ]; then
    cd -- "$TMPDIR" && rm -rf autoconf-$version
fi